@echo off
setlocal
title Instalador - Henkkes Player
echo.
echo   Henkkes Player - instalador
echo   ---------------------------
echo.

set "SELF=%~f0"
set "VSIX=%TEMP%\henkkes-player.vsix"

echo   [1/3] Extraindo a extensao...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$c=[IO.File]::ReadAllText($env:SELF); $m='::'+'PAYLOAD::'; $b=$c.Substring($c.LastIndexOf($m)+$m.Length); [IO.File]::WriteAllBytes($env:VSIX,[Convert]::FromBase64String($b.Trim()))"
if errorlevel 1 goto :fail_extract

echo   [2/3] Procurando o VS Code...
set "CODE="
where code >nul 2>nul && set "CODE=code"
if not defined CODE if exist "%LOCALAPPDATA%\Programs\Microsoft VS Code\bin\code.cmd" set "CODE=%LOCALAPPDATA%\Programs\Microsoft VS Code\bin\code.cmd"
if not defined CODE if exist "%ProgramFiles%\Microsoft VS Code\bin\code.cmd" set "CODE=%ProgramFiles%\Microsoft VS Code\bin\code.cmd"
if not defined CODE if exist "%ProgramFiles(x86)%\Microsoft VS Code\bin\code.cmd" set "CODE=%ProgramFiles(x86)%\Microsoft VS Code\bin\code.cmd"
if not defined CODE goto :fail_code

echo   [3/3] Instalando...
call "%CODE%" --install-extension "%VSIX%" --force
if errorlevel 1 goto :fail_install

del "%VSIX%" >nul 2>nul
echo.
echo   Pronto! Recarregue o VS Code (Ctrl+Shift+P ^> "Reload Window")
echo   e abra o Explorer: o player aparece na secao "Tocando agora".
echo.
pause
exit /b 0

:fail_extract
echo.
echo   Nao consegui extrair a extensao. Tente baixar o .vsix direto pelo site.
echo.
pause
exit /b 1

:fail_code
echo.
echo   Nao encontrei o VS Code. Instale em https://code.visualstudio.com
echo   ou, no VS Code, rode "Shell Command: Install 'code' command in PATH".
echo.
pause
exit /b 1

:fail_install
echo.
echo   A instalacao falhou. Feche o VS Code e rode o instalador de novo.
echo.
pause
exit /b 1

